# Session encryption key for nuxt-auth-utils (required)
NUXT_SESSION_PASSWORD=randomly-generated-password-here-32-characters-minimum

# Optional: admin secret for maintenance endpoints
NUXT_ADMIN_SECRET_KEY=

# ---------------------------------------------------------------------------
# Media storage (product images & technical PDFs)
# ---------------------------------------------------------------------------
# Storage uses NuxtHub blob:
#   - development: files land on local disk in .data/hub/blob (zero config)
#   - production:  files land in the Cloudflare R2 bucket bound as "BLOB"
#     (see wrangler.toml: [[r2_buckets]] binding = "BLOB")
#
# Create the bucket once:   wrangler r2 bucket create atlas-inventory-media
# No access keys are needed: the R2 binding authenticates the Worker directly,
# which replaces the classic R2_ACCOUNT_ID / R2_ACCESS_KEY_ID / R2_SECRET_*
# env-var setup. Files are served through /media/* with immutable cache headers.
